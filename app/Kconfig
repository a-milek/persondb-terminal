module = APP_CBOR_PERSONDB
module-str = APP_CBOR_PERSONDB
source "subsys/logging/Kconfig.template.log_config"

# The full-screen terminal on the console UART, navigated with the arrow keys.
# Needs a VT100-compatible terminal (minicom, picocom, screen, PuTTY); the size
# is queried at start and with Ctrl+L. The log backends are paused while it
# runs.
config APP_CBOR_PERSONDB_TUI
	bool
	default y
	select SERIAL
	select UART_INTERRUPT_DRIVEN

# On native_sim the TUI is most useful in the invoking terminal, which it
# then reads and draws exactly as it would a board's serial port. Put the
# terminal in raw mode first (stty raw -echo) so the arrow keys arrive
# unbuffered; --attach_uart still moves it to a pseudoterminal instead.
choice UART_NATIVE_PTY_0
	default UART_NATIVE_PTY_0_ON_STDINOUT
endchoice

config APP_CBOR_PERSONDB_FRESH_START
	bool "Erase the store at boot (start over)"
	help
	  Drop everything before opening, so this run behaves like the very
	  first one. Use once to reset a board that already holds a store; on
	  native_sim prefer the --flash_erase command-line option.

# Sourced last on purpose. Kconfig resolves a symbol's `default` to the first
# one it parses, so any Zephyr default this app overrides — see
# UART_NATIVE_PTY_0 above — must be stated before this line, not after.
menu "Zephyr"
source "Kconfig.zephyr"
endmenu
